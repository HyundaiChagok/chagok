<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 차량 SDK를 쓰는 앱인지 찾는 데 쓴다(:pleos의 SDK가 같은 action을 선언한다). -->
    <queries>
        <intent>
            <action android:name="ai.pleos.playground.vehicle.VEHICLE_START" />
        </intent>
    </queries>

    <application
        android:name=".ChagokApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Chagok">

        <!--
            주행 중 화면 제한(distractionOptimized)을 선언하지 않는다. 플랫폼이 주행 중에 이 화면을 막고,
            인수·반납 단계는 정차 중에만 진행한다(요구사항 SAF-01).
            Pleos는 앱 두 개를 나란히 띄우면 세로 창을 주므로 방향을 고정하지 않는다(디자인 가이드 Display Layout).
            창 크기나 낮/밤이 바뀌어도 화면을 다시 만들지 않고 Compose가 다시 그린다.
            런처에서 다시 눌러도 진행 중인 대여 화면이 하나만 있도록 singleTask로 둔다.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
