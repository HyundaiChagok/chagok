<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 대여 중 기록 서비스(RecordingService). 대여가 열려 있을 때만 돌고, 재부팅 뒤에도 그 대여를 잇는다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 차량 SDK를 쓰는 앱인지 찾는 데 쓴다(:pleos의 SDK가 같은 action을 선언한다). -->
    <queries>
        <intent>
            <action android:name="ai.pleos.playground.vehicle.VEHICLE_START" />
        </intent>
        <!-- API 30부터 선언하지 않으면 TTS 엔진을 찾지 못해 초기화가 실패하고 조용히 자막만 나온다. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ChagokApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Chagok">

        <!--
            주행 중 화면 제한(distractionOptimized)을 선언하지 않는다. 플랫폼이 주행 중에 이 화면을 막고,
            인수·반납 단계는 정차 중에만 진행한다(요구사항 SAF-01).
            Pleos는 앱 두 개를 나란히 띄우면 세로 창을 주므로 방향을 고정하지 않는다(디자인 가이드 Display Layout).
            창 크기나 낮/밤, 글자 크기가 바뀌어도 화면을 다시 만들지 않고 Compose가 다시 그린다.
            런처에서 다시 눌러도 진행 중인 대여 화면이 하나만 있도록 singleTask로 둔다.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo 함수(assets/schema.json, component=activity). 어느 앱이든 보낼 수 있어 되돌릴 수 있는 일만 받는다. 확정·무효·닫기는 입구가 없다. -->
            <intent-filter>
                <action android:name="RENTAL_START_RETURN_CHECK" />
                <action android:name="RENTAL_SHOW_RECORD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".rental.RecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="rental_vehicle_state_log" />
        </service>

        <!-- Gleo 함수(component=service). 화면 없이 지금 확인할 것을 답한다. Gleo가 sendBroadcast로 부르므로 내보낸다. 차를 읽기만 한다. -->
        <receiver
            android:name=".rental.GleoReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="RENTAL_WHAT_TO_CHECK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".rental.RecordingRestarter"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
